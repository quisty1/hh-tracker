generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One local user per instance (loginKey = "local")
model User {
  id           Int           @id @default(autoincrement())
  loginKey     String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

// Job application (manual entry, from-url, or CSV import)
model Application {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stable dedupe key (vacancy-{id}, demo-N, csv-…)
  externalId      String?
  // HH vacancy ID (may be missing for manual entry)
  vacancyId       String?
  vacancyName     String?
  vacancyUrl      String?

  employerId      String?
  employerName    String?
  employerLogoUrl String?

  areaName        String?
  // true = remote work (not to be confused with areaName)
  isRemote        Boolean  @default(false)
  salaryFrom      Int?
  salaryTo        Int?
  salaryCurrency  String?
  // true = before income tax (gross)
  salaryGross     Boolean?

  // id from APPLICATION_STATUSES
  status          String
  appliedAt       DateTime
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // One externalId per user (multiple nulls are allowed in SQLite)
  @@unique([userId, externalId])
  @@index([userId, appliedAt])
  @@index([employerName])
  @@index([status])
}
