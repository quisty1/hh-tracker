generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Один локальный пользователь на инстанс (loginKey = "local")
model User {
  id           Int           @id @default(autoincrement())
  loginKey     String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

// Отклик на вакансию (ручной ввод, from-url или CSV-импорт)
model Application {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Стабильный ключ дедупа (vacancy-{id}, demo-N, csv-…)
  externalId      String?
  // ID вакансии на HH (может отсутствовать при ручном вводе)
  vacancyId       String?
  vacancyName     String?
  vacancyUrl      String?

  employerId      String?
  employerName    String?
  employerLogoUrl String?

  areaName        String?
  // true = удалённая работа (не путать с areaName)
  isRemote        Boolean  @default(false)
  salaryFrom      Int?
  salaryTo        Int?
  salaryCurrency  String?
  // true = до вычета НДФЛ
  salaryGross     Boolean?

  // id из APPLICATION_STATUSES
  status          String
  appliedAt       DateTime
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Один externalId на пользователя (null допустим несколько раз в SQLite)
  @@unique([userId, externalId])
  @@index([userId, appliedAt])
  @@index([employerName])
  @@index([status])
}
