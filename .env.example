# Password for /login
APP_PASSWORD=change-me
# iron-session secret (at least ~32 characters, random string)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# SQLite: file relative to prisma/
DATABASE_URL="file:./dev.db"
# User-Agent for api.hh.ru (required by HH rules)
HH_USER_AGENT=HhTracker/1.0 (you@example.com)
