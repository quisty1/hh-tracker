# Пароль для входа на /login
APP_PASSWORD=change-me
# Секрет iron-session (минимум ~32 символа, случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# SQLite: файл относительно prisma/
DATABASE_URL="file:./dev.db"
# User-Agent для api.hh.ru (обязателен правилами HH)
HH_USER_AGENT=HhTracker/1.0 (you@example.com)
